# ---------------------------------------------------------------------------
# Narmada Engineering Works — site configuration
# Copy this file to `.env` and fill in the values you need, then rebuild.
# Everything here is optional; the site works with all of it left blank.
# ---------------------------------------------------------------------------

# Your live domain, no trailing slash. Used for canonical URLs, the sitemap
# and the schema.org data that Google reads.
VITE_SITE_URL=https://www.narmadaengineeringworks.com

# --- Visitor tracking -------------------------------------------------------
# Google Analytics 4 — how many people visit, where from, which pages, devices.
# Get this from analytics.google.com → Admin → Data streams → Measurement ID.
VITE_GA_MEASUREMENT_ID=

# Microsoft Clarity — free session recordings and heatmaps.
# Get this from clarity.microsoft.com → Settings → Project ID.
VITE_CLARITY_PROJECT_ID=

# Plausible — cookie-free, privacy-friendly alternative. Put your domain here.
VITE_PLAUSIBLE_DOMAIN=

# Set to true if you want to test tracking while running `pnpm dev`.
VITE_ANALYTICS_IN_DEV=false

# Set to false to keep tracking visitors who send a Do-Not-Track header.
VITE_ANALYTICS_RESPECT_DNT=true
